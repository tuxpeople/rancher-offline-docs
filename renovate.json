{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tuxpeople/shared//renovate/renovate.json5",
    "github>tuxpeople/shared//renovate/labels.json5",
    "github>tuxpeople/shared//renovate/semanticCommits.json5"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "forkProcessing": "enabled",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Hugo has to match HUGO_VERSION in longhorn/website's netlify.toml; newer versions fail to render the site. Update it by hand when upstream does.",
      "matchPackageNames": [
        "gohugoio/hugo"
      ],
      "enabled": false
    }
  ]
}
